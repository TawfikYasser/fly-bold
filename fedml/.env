# Flybold FEDML Configuration
# Dataset choice (1-5 for different data partitions)
DATASET=1

# Training Configuration
NUM_CLIENTS=10
NUM_SERVER_ROUNDS=5
LOCAL_EPOCHS=2
BATCH_SIZE=16
LR=0.001

# Model Configuration
YOLO_SIZE=s
IMG_SIZE=416

# Hardware Configuration
ENABLE_GPU=false
NUM_CPUS=4
NUM_GPUS=0

# Security Configuration
ENABLE_TLS=false
INSECURE=true

# Server Configuration (will be updated during deployment)
SERVER_INTERNAL_IP=10.128.0.1

# Docker Configuration (will be updated by build script)
DOCKER_IMAGE=twkdocker/flybold-fedml-yolov5:latest

# RUN_ID (will be auto-generated)
RUN_ID=0

# GCS Configuration
GCS_BUCKET=flybold-coco-inf022


# Run Configuration (will be auto-generated)
RUN_ID=0

# GCS Configuration
GCS_BUCKET=flybold-coco-inf022
