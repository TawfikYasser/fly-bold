# ===============================================
# Flybold Federated Learning Configuration
# ===============================================

# GPU & TLS Settings
ENABLE_GPU=false
ENABLE_TLS=false
INSECURE=true

MIN_TRAIN_IMAGES=4000         # Minimum training images per client
MAX_TRAIN_IMAGES=5000         # Maximum training images per client
MIN_VAL_IMAGES=400            # Minimum validation images per client
MAX_VAL_IMAGES=500            # Maximum validation images per client
DIRICHLET_SEED=42             # Random seed for reproducibility
SAME_SEED_VAL=true            # true = val follows same alpha distribution as train

# RUN ID: 5 Server Optuna/FLAML trials, 10 clients, 5 client Optuna/FLAML trials, 3 for fedadam, 000 for non-iid dataset, 1 for Optuna (2 for flaml) 
RUN_ID=510530001               
NUM_SERVER_ROUNDS=10         # Number of federated rounds
NUM_CLIENTS=10                # Total number of clients (auto-synced with DEPLOYMENT_MODE)
LOCAL_EPOCHS=3                # Training epochs per round per client
BATCH_SIZE=32                 # Batch size for training
FRACTION_TRAIN=1              # Fraction of clients to use for training
FRACTION_EVALUATE=1           # Fraction of clients to use for evaluation
LR=0.000259                      # Learning rate
USE_PRETRAINED=1              # Whether to use a pretrained model (0 = train from scratch, 1 = use pretrained)
PRETRAINED_CHECKPOINT=        # Optional: Path to previous .pt checkpoint to resume training from (absolute or relative path)
DATASET=0                   # Dataset choice for training (100=100% IID, 50=50% IID, 000=100% non-IID)
STRATEGY=3                    # Client selection strategy

# HPO Backend Selection -- NESTED HPO MODE
# Server searches ONLY lr. Clients search ONLY local_epochs/batch_size
# (see CLIENT_HPO_ENABLED below). Both follow USE_FLAML -- flip this ONE
# value to switch experiments, nothing else needs to change.
#   Experiment A: USE_FLAML=false  -> Optuna (TPE) on both server and clients
#   Experiment B: USE_FLAML=true   -> FLAML (BlendSearch) on both
USE_FLAML=false                # true = use FLAML, false = use Optuna (if HPO_TRIALS > 0)
HPO_TRIALS=5                   # Server-side trials -- each suggests one lr candidate
HPO_ROUNDS=1                   # Federated rounds run per server trial (proxy budget)
HPO_MODE=hpo_only         # "hpo_only" = HPO only, "hpo_then_train" = HPO then final training with the winning lr

# FLAML-specific parameters (when USE_FLAML=true)
FLAML_TIME_BUDGET=36000        # Total time budget in seconds (1 hour default)
FLAML_METRIC=mAP50            # Optimization metric: mAP50, mAP, loss, accuracy
FLAML_ESTIMATOR=lgb           # Estimator type: lgb (default)
FLAML_SAMPLE_SIZE=32          # Number of samples per HPO iteration
FLAML_USE_COE=false           # Use cost-aware early exit
FLAML_LOG_HISTORY=true        # Log trial history to file

# Optuna-specific parameters (when USE_FLAML=false)
# Both Optuna and FLAML use the same HPO_TRIALS and HPO_ROUNDS

# Client-side HPO -- MUST be true for nested-HPO mode (paired with
# HPO_TRIALS > 0 above): each client runs its own inner search every round,
# conditioned on that round's server-suggested lr, and reports its winning
# (epochs, batch, train mAP) back up so the server sees the full joint
# (lr, epochs, batch) -> mAP record, not just lr -> mAP.
CLIENT_HPO_ENABLED=true        # true = each client runs its own inner search every round
CLIENT_HPO_TRIALS=5            # Local trials per client PER ROUND (cost multiplier -- see pyproject.toml note)

# Adaptive Batch/Epoch Tuning (ABS -- client-side, per round)
# MUST be false for nested-HPO mode -- mutually exclusive with
# CLIENT_HPO_ENABLED (if both true, ABS silently wins and client HPO is
# skipped for that round; a warning is printed).
ADAPTIVE_BATCH_ENABLED=false
ADAPTIVE_BATCH_MIN=8               # beta_min
ADAPTIVE_BATCH_MAX=64               # beta_max
ADAPTIVE_BATCH_MAX_INCREASES=4      # H_beta -- max batch-size bumps per round
ADAPTIVE_BATCH_RMD_THRESHOLD=0.01   # rho threshold below which learning is "stalled"
ADAPTIVE_BATCH_RMD_PATIENCE=2       # consecutive stalled epochs before bumping batch
ADAPTIVE_BATCH_GROWTH_FACTOR=2.0    # multiplicative batch growth per bump
ADAPTIVE_BATCH_MAX_EPOCHS=10        # hard safety ceiling on epochs/round

# Adaptive Global LR Tuning (ALR -- server-side, final run only, not during HPO)
# Set to false for the nested-HPO experiments: the final run should use the
# HPO-winning lr as-is, not have ALR further adjust it on top.
ADAPTIVE_LR_ENABLED=false
ADAPTIVE_LR_MIN=0.0001              # lambda_min
ADAPTIVE_LR_MAX=0.01                # lambda_max (initial upper bound)
ADAPTIVE_LR_MAX_REDUCTIONS=3        # H_lambda -- max LR rollbacks before terminating
ADAPTIVE_LR_GROWTH_FACTOR=1.2       # multiplicative LR growth on improvement
ADAPTIVE_LR_BACKOFF_FACTOR=0.5      # multiplicative LR shrink on regression

# Model Settings
YOLO_SIZE=s                   # YOLO model size: n, s, m, l, x
IMG_SIZE=416                  # Input image size

# Infrastructure Settings
NUM_CPUS=5                    # CPUs per client container
NUM_GPUS=0                    # GPUs per client container (if ENABLE_GPU=true)
FLWR_SUPERLINK_ADDRESS=0.0.0.0:9092
BUCKET_NAME=flybold-coco-inf022
DOCKER_IMAGE=twkdocker/fly-bold-image:latest

# Project Settings
PROJECT_ID=inf022
REGION=us-central1