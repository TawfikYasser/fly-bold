# ===============================================
# Flybold Federated Learning Configuration
# ===============================================

# GPU & TLS Settings
ENABLE_GPU=false
ENABLE_TLS=false
INSECURE=true

# Dataset Partitioning Settings
# ----------------------------------------------
# Four datasets will be generated with different IID/non-IID configurations:
#   Dataset 1: All 10 clients IID (alpha=1e6)
#   Dataset 2: Clients 0-4 IID (alpha=1e6), Clients 5-9 non-IID (alpha=0.5-1.5)
#   Dataset 3: Clients 0-1 IID (alpha=1e6), Clients 2-9 non-IID (alpha=0.5-1.5)
#   Dataset 4: All 10 clients non-IID (alpha=0.5-1.5)

# Storage locations on VMs:
#   Dataset 1: /app/datasets_1/coco_partitions/client_X/
#   Dataset 2: /app/datasets_2/coco_partitions/client_X/
#   Dataset 3: /app/datasets_3/coco_partitions/client_X/
#   Dataset 4: /app/datasets_4/coco_partitions/client_X/

MIN_TRAIN_IMAGES=1300         # Minimum training images per client
MAX_TRAIN_IMAGES=1500         # Maximum training images per client
MIN_VAL_IMAGES=500            # Minimum validation images per client
MAX_VAL_IMAGES=800            # Maximum validation images per client
DIRICHLET_SEED=42             # Random seed for reproducibility
SAME_SEED_VAL=true            # true = val follows same alpha distribution as train

# Training Settings
RUN_ID=34
NUM_SERVER_ROUNDS=5           # Number of federated rounds
NUM_CLIENTS=10                # Total number of clients
LOCAL_EPOCHS=3                # Training epochs per round per client
BATCH_SIZE=24                 # Batch size for training
FRACTION_TRAIN=1              # Fraction of clients to use for training
FRACTION_EVALUATE=1           # Fraction of clients to use for evaluation
LR=0.001                      # Learning rate
USE_PRETRAINED=1              # Whether to use a pretrained model (0 = train from scratch, 1 = use pretrained)
DATASET=1                     # Dataset choice for training (1=100% IID, 2=50% IID, 3=20% IID, 4=100% non-IID)

# Model Settings
YOLO_SIZE=s                   # YOLO model size: n, s, m, l, x
IMG_SIZE=640                  # Input image size

# Infrastructure Settings
NUM_CPUS=8                    # CPUs per client container
NUM_GPUS=0                    # GPUs per client container (if ENABLE_GPU=true)
FLWR_SUPERLINK_ADDRESS=0.0.0.0:9092
BUCKET_NAME=flybold-coco-inf022
DOCKER_IMAGE=twkdocker/fly-bold-image:latest

# Project Settings
PROJECT_ID=inf022
REGION=us-central1
