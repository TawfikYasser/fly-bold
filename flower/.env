# ===============================================
# Flybold Federated Learning Configuration
# ===============================================

# GPU & TLS Settings
ENABLE_GPU=false
ENABLE_TLS=false
INSECURE=true

# Dataset Partitioning Settings
MIN_TRAIN=1000                # Minimum training images per client
MAX_TRAIN=10000                # Maximum training images per client
# Note: Val size is automatically 50% of train size
DIRICHLET_SEED=42             # Random seed for reproducibility
DIRICHLET_ALPHA_MIN=0.1       # Min Dirichlet alpha for clients 1-9
DIRICHLET_ALPHA_MAX=1.5       # Max Dirichlet alpha for clients 1-9
# Note: Client 0 always gets alpha=1e6 (uniform distribution)
SAME_SEED_VAL=true           # true = same distribution for train/val, false = different

# Training Settings
RUN_ID=69
NUM_SERVER_ROUNDS=10          # Number of federated rounds
NUM_CLIENTS=10                # Total number of clients
LOCAL_EPOCHS=3                # Training epochs per round per client
BATCH_SIZE=32                 # Batch size for training
FRACTION_TRAIN=1            # Fraction of clients to use for training
FRACTION_EVALUATE=1         # Fraction of clients to use for evaluation
LR=0.0025                      # Learning rate

# Model Settings
YOLO_SIZE=s                   # YOLO model size: n, s, m, l, x
IMG_SIZE=640                  # Input image size

# Infrastructure Settings
NUM_CPUS=4                    # CPUs per client container
NUM_GPUS=0                    # GPUs per client container (if ENABLE_GPU=true)
FLWR_SUPERLINK_ADDRESS=0.0.0.0:9092
BUCKET_NAME=flybold-coco-inf022
DOCKER_IMAGE=twkdocker/fly-bold-image:latest

# Project Settings
PROJECT_ID=inf022
REGION=us-central1