# ===============================================
# Flybold Federated Learning Configuration
# ===============================================

# GPU & TLS Settings
ENABLE_GPU=false
ENABLE_TLS=false
INSECURE=true

MIN_TRAIN_IMAGES=4000         # Minimum training images per client
MAX_TRAIN_IMAGES=5000         # Maximum training images per client
MIN_VAL_IMAGES=400            # Minimum validation images per client
MAX_VAL_IMAGES=500            # Maximum validation images per client
DIRICHLET_SEED=42             # Random seed for reproducibility
SAME_SEED_VAL=true            # true = val follows same alpha distribution as train

# RID: Encodes the number of trials, rounds per trial, number of clients, dataset identifier, and the experiment sequence index.

RUN_ID=301033200031               
NUM_SERVER_ROUNDS=30         # Number of federated rounds
NUM_CLIENTS=10                # Total number of clients
LOCAL_EPOCHS=3                # Training epochs per round per client
BATCH_SIZE=32                 # Batch size for training
FRACTION_TRAIN=1              # Fraction of clients to use for training
FRACTION_EVALUATE=1           # Fraction of clients to use for evaluation
LR=0.000259                      # Learning rate
USE_PRETRAINED=1              # Whether to use a pretrained model (0 = train from scratch, 1 = use pretrained)
DATASET=0                   # Dataset choice for training (100=100% IID, 50=50% IID, 000=100% non-IID)
STRATEGY=3                    # Client selection strategy
OPTUNA_TRIALS=0               # Number of Optuna HPO trials (0 to disable HPO)
HPO_ROUNDS=0                    # Number of rounds to run each Optuna trial

# Model Settings
YOLO_SIZE=s                   # YOLO model size: n, s, m, l, x
IMG_SIZE=416                  # Input image size

# Infrastructure Settings
NUM_CPUS=5                    # CPUs per client container
NUM_GPUS=0                    # GPUs per client container (if ENABLE_GPU=true)
FLWR_SUPERLINK_ADDRESS=0.0.0.0:9092
BUCKET_NAME=flybold-coco-inf022
DOCKER_IMAGE=twkdocker/fly-bold-image:latest

# Project Settings
PROJECT_ID=inf022
REGION=us-central1